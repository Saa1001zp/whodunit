# how many frames to show at most
WHODUNIT_MAX_FRAMES=30

# scoring weights - tune to taste
WHODUNIT_W_RECENCY=1.0
WHODUNIT_W_DIRTY=2.0
WHODUNIT_W_CHURN=0.5
WHODUNIT_W_DEPTH=0.7

# after how many days "freshness" drops by half (recency decay)
WHODUNIT_RECENCY_DECAY_DAYS=30

# how many recent commits of the file count as churn
WHODUNIT_CHURN_COMMITS=20
# how many commits make a file "hot" (100% churn)
WHODUNIT_CHURN_REF=10

# git timeout in seconds
WHODUNIT_GIT_TIMEOUT=10
